# Modelo do serviço do systemd. Não use este arquivo direto: o instalar.sh troca
# os marcadores __ASSIM__ pelos valores reais da sua máquina e grava o resultado
# em /etc/systemd/system/dominio-pelo-saber.service.

[Unit]
Description=Domínio pelo Saber - servidor do jogo
Documentation=https://github.com/zmixtv1/GameConhecimentoEPoder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USUARIO__
WorkingDirectory=__DIRETORIO__/server
Environment=NODE_ENV=production
Environment=PORTA=__PORTA__

# network-online.target sozinho não basta num Pi com Wi-Fi: a interface sobe
# antes de ter IP. Veja o comentário em esperar-rede.sh.
ExecStartPre=__DIRETORIO__/raspberry-pi/esperar-rede.sh
ExecStart=__NODE__ index.js

# Se o jogo cair no meio da festa, volta sozinho em 5s. Ninguém precisa buscar
# um teclado.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
